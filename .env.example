# Copy this file to `.env.local` and fill in the values.
# On Vercel, set these in Project → Settings → Environment Variables.

# --- Database (Vercel Postgres / Neon) -------------------------------
# In the Vercel dashboard: Storage → Create Database → Postgres/Neon.
# Then run `vercel env pull .env.local` (or paste the string from the
# database's ".env.local" tab). Any of these names is accepted:
POSTGRES_URL="postgres://user:password@host/db?sslmode=require"
# DATABASE_URL="..."
# DATABASE_URL_UNPOOLED="..."   # used for migrations when present

# --- Auth ------------------------------------------------------------
# Signs access + refresh JWTs. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""
# Optional; defaults to AUTH_SECRET when unset.
AUTH_REFRESH_SECRET=""

# --- AI (OpenAI) -----------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Optional --------------------------------------------------------
# Override the map tile server (defaults to OpenStreetMap raster tiles).
NEXT_PUBLIC_MAP_TILES=""
# Postgres pool size per serverless instance (default 3).
PG_POOL_MAX="3"
